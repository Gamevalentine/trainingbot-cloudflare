---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { env } from 'cloudflare:workers';
interface Props { title?: string; description?: string; image?: string; canonical?: string; structuredData?: Record<string, unknown> | null; }
const { title = 'Toolpick', description, image, canonical, structuredData } = Astro.props;
const path = Astro.url.pathname;
const ownerEmail = String(env.OWNER_EMAIL || '').trim();
const year = new Date().getFullYear();
---
<BaseLayout title={title} description={description} image={image} canonical={canonical} structuredData={structuredData}>
  <header class="site-header"><div class="container header-inner"><a class="brand" href="/"><span class="brand-mark">T</span><span>Toolpick</span></a><nav class="desktop-nav"><a class:list={[path === '/explore' && 'active']} href="/explore">Khám phá</a><a class:list={[path.startsWith('/category') && 'active']} href="/categories">Danh mục</a><a href="/explore#new">Mới</a></nav><form class="header-search" action="/search"><Icon name="search" size={18}/><input name="q" aria-label="Tìm kiếm" placeholder="Tìm công cụ..." /></form><button class="theme-toggle" data-theme-toggle aria-label="Đổi giao diện">◐</button></div></header>
  <main><slot /></main>
  <footer class="site-footer site-footer--rich">
    <div class="container footer-main">
      <section class="footer-about">
        <a class="brand" href="/"><span class="brand-mark">T</span><span>Toolpick</span></a>
        <h2>Kho công cụ web dành cho những việc bạn cần làm</h2>
        <p>Tìm kiếm, khám phá và mở nhanh các website, web app và công cụ nhỏ theo đúng nhu cầu — không cần nhớ tên dự án hay chúng đang nằm ở đâu.</p>
      </section>
      <nav class="footer-column" aria-label="Khám phá">
        <h2>Khám phá</h2>
        <a href="/">Trang chủ</a>
        <a href="/explore">Khám phá công cụ</a>
        <a href="/search">Tìm theo nhu cầu</a>
        <a href="/categories">Tất cả danh mục</a>
      </nav>
      <section class="footer-column">
        <h2>Liên hệ</h2>
        <p class="footer-contact-copy">Góp ý, báo lỗi hoặc đề xuất một công cụ nên có trong Toolpick.</p>
        {ownerEmail ? <a class="footer-contact" href={`mailto:${ownerEmail}`}>Gửi email quản trị</a> : <span class="footer-contact-muted">Kênh liên hệ quản trị sẽ hiển thị sau khi được cấu hình.</span>}
      </section>
    </div>
    <div class="container footer-bottom"><span>© {year} Toolpick</span><span>Kho công cụ web cá nhân · Public tools không yêu cầu đăng nhập</span></div>
  </footer>
  <nav class="mobile-bottom-nav"><a class:list={[path === '/' && 'active']} href="/"><Icon name="home"/><span>Trang chủ</span></a><a class:list={[path === '/explore' && 'active']} href="/explore"><Icon name="compass"/><span>Khám phá</span></a><a class:list={[path === '/search' && 'active']} href="/search"><Icon name="search"/><span>Tìm kiếm</span></a><a class:list={[path.startsWith('/categor') && 'active']} href="/categories"><Icon name="folder"/><span>Danh mục</span></a></nav>
</BaseLayout>
