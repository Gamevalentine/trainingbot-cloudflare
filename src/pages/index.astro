---
import PublicLayout from '../layouts/PublicLayout.astro'; import AppGrid from '../components/AppGrid.astro'; import Icon from '../components/Icon.astro'; import { listCategories, listPublicApps } from '../lib/db';
const [categories,featured,updated]=await Promise.all([listCategories(),listPublicApps({featured:true,limit:4}),listPublicApps({sort:'updated',limit:4})]); const visibleCategories=categories.filter(c=>(c.app_count||0)>0).slice(0,8);
---
<PublicLayout title="Web Tools Hub · Tìm đúng công cụ bạn cần" description="Tìm kiếm và sử dụng các website, web app và công cụ nhỏ phù hợp với điều bạn muốn làm."><section class="hero"><div class="container hero-inner"><p class="eyebrow">Web Tools Hub</p><h1>Tìm công cụ phù hợp với điều bạn muốn làm</h1><p class="hero-copy">Không cần nhớ tên ứng dụng. Mô tả việc bạn cần, hệ thống sẽ giúp bạn tìm đúng công cụ.</p><form class="hero-search" action="/search"><Icon name="search" size={24}/><input name="q" placeholder="Bạn đang muốn làm gì?" autocomplete="off"/><button type="submit">Tìm</button></form><div class="search-examples"><span>Thử:</span><a href="/search?q=học cấp cứu">học cấp cứu</a><a href="/search?q=chỉnh sửa video">chỉnh sửa video</a><a href="/search?q=tạo website">tạo website</a></div></div></section>{visibleCategories.length>0&&<section class="container category-strip" aria-label="Danh mục">{visibleCategories.map(c=><a href={`/category/${c.slug}`}><Icon name={c.icon} size={18}/>{c.name}</a>)}<a href="/categories">Tất cả →</a></section>}<section class="container section-block"><div class="section-heading"><div><p class="eyebrow">Chọn nhanh</p><h2>Được đề xuất</h2></div><a href="/explore">Khám phá tất cả →</a></div><AppGrid apps={featured}/></section><section class="container section-block"><div class="section-heading"><div><p class="eyebrow">Gần đây</p><h2>Mới cập nhật</h2></div><a href="/explore#new">Xem thêm →</a></div><AppGrid apps={updated}/></section></PublicLayout>
