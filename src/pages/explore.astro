---
import PublicLayout from '../layouts/PublicLayout.astro'; import AppGrid from '../components/AppGrid.astro'; import { listPublicApps } from '../lib/db';
const [newApps,updated,popular,featured]=await Promise.all([listPublicApps({sort:'new',limit:4}),listPublicApps({sort:'updated',limit:4}),listPublicApps({sort:'popular',limit:4}),listPublicApps({featured:true,sort:'updated',limit:4})]);
const groups=[['AI Tools','ai'],['Medical Tools','y-khoa'],['Game Tools','game'],['Productivity','nang-suat'],['Developer Tools','developer-tools']];
const structuredData={'@context':'https://schema.org','@type':'CollectionPage',name:'Khám phá công cụ · Toolpick',description:'Mới thêm, mới cập nhật, nổi bật và các nhóm công cụ đáng khám phá.',url:new URL('/explore',Astro.url.origin).toString()}; const categoryGroups=[]; for(const [name,slug] of groups){const apps=await listPublicApps({category:slug,limit:4});if(apps.length)categoryGroups.push({name,slug,apps});}
---
<PublicLayout title="Khám phá · Toolpick" description="Mới thêm, mới cập nhật, nổi bật và các nhóm công cụ đáng khám phá." structuredData={structuredData}><section class="container page-hero"><p class="eyebrow">Khám phá</p><h1>Một nơi để tìm công cụ tiếp theo</h1><p>Duyệt những gì mới, được đề xuất và đang được sử dụng nhiều.</p></section>{featured.length>0&&<section class="container section-block"><div class="section-heading"><div><p class="eyebrow">Đề xuất</p><h2>Được đề xuất</h2></div></div><AppGrid apps={featured}/></section>}{featured.length>0&&<section class="container section-block"><div class="section-heading"><div><p class="eyebrow">Nổi bật</p><h2>Web nổi bật</h2></div></div><AppGrid apps={featured.slice(0,3)}/></section>}<section id="new" class="container section-block"><div class="section-heading"><div><p class="eyebrow">Gần đây</p><h2>Mới thêm</h2></div></div><AppGrid apps={newApps}/></section><section class="container section-block"><div class="section-heading"><div><p class="eyebrow">Cập nhật</p><h2>Mới cập nhật</h2></div></div><AppGrid apps={updated}/></section><section class="container section-block"><div class="section-heading"><div><p class="eyebrow">Sử dụng</p><h2>Được dùng nhiều</h2></div></div><AppGrid apps={popular}/></section>{categoryGroups.map(g=><section class="container section-block"><div class="section-heading"><div><p class="eyebrow">Danh mục</p><h2>{g.name}</h2></div><a href={`/category/${g.slug}`}>Xem tất cả →</a></div><AppGrid apps={g.apps}/></section>)}</PublicLayout>
