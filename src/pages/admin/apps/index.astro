---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Icon from '../../../components/Icon.astro';
import { adminApps, listCategories } from '../../../lib/db';
import { statusLabel } from '../../../lib/utils';
const [apps,categories]=await Promise.all([adminApps(),listCategories(false)]);
const publicCount=apps.filter((a:any)=>a.visibility==='public').length; const privateCount=apps.length-publicCount;
const offlineCount=apps.filter((a:any)=>a.status==='offline').length;
const incompleteCount=apps.filter((a:any)=>!a.category_id||!a.icon_key||!a.cover_key||!a.short_description||!a.primary_use).length;
const health=(app:any)=>!app.last_checked_at?'idle':((app.last_http_status>=200&&app.last_http_status<400)||[401,403,429].includes(Number(app.last_http_status))?'up':'down');
const flash=Astro.url.searchParams.get('bulk'); const flashCount=Astro.url.searchParams.get('count');
---
<AdminLayout title="Website">
  <section class="admin-section-intro"><div><p class="eyebrow">Kho nội dung</p><h2>Quản lý website</h2><p>{apps.length} website · {publicCount} public · {privateCount} private</p></div><div class="admin-intro-actions"><a class="button ghost" href="/admin/apps/import">Nhập từ URL</a><a class="button primary" href="/admin/apps/new">+ Thêm website</a></div></section>
  {flash && <div class="admin-notice"><strong>{flash==='public'?'Đã publish':'Đã chuyển về Private'} {flashCount||''} website.</strong><span>Thay đổi quyền xem đã được áp dụng.</span></div>}
  <section class="admin-app-summary"><div><b>{offlineCount}</b><span>Offline</span></div><div><b>{incompleteCount}</b><span>Thiếu dữ liệu</span></div><div><b>{apps.filter((a:any)=>a.monitor_enabled===1).length}</b><span>Đang theo dõi</span></div></section>
  <form class="admin-bulk-bar" method="post" action="/api/admin/apps/bulk" data-bulk-form><div><strong data-selected-count>0</strong> đã chọn</div><div><button class="button ghost small" name="action" value="publish" type="submit">Publish</button><button class="button ghost small" name="action" value="private" type="submit">Private</button></div><div data-bulk-hidden></div></form>
  <section class="admin-filter-bar"><div class="admin-search-field"><Icon name="search" size={17}/><input data-app-search placeholder="Tìm theo tên hoặc URL..."/></div><select data-app-category><option value="">Tất cả danh mục</option>{categories.map((c)=><option value={c.id}>{c.name}</option>)}</select><select data-app-visibility><option value="">Tất cả quyền xem</option><option value="public">Public</option><option value="private">Private</option></select><select data-app-status><option value="">Tất cả trạng thái</option>{['active','development','beta','paused','archived','offline'].map((s)=><option value={s}>{statusLabel(s)}</option>)}</select><select data-app-completeness><option value="">Tất cả dữ liệu</option><option value="complete">Đủ dữ liệu</option><option value="incomplete">Thiếu dữ liệu</option></select></section>
  {apps.length?<div class="admin-app-list">{apps.map((app:any)=>{const missing=[!app.category_id,!app.icon_key||!app.cover_key,!app.short_description,!app.primary_use].filter(Boolean).length;return <article class="admin-app-row" data-app-row data-search={`${app.name} ${app.production_url}`.toLowerCase()} data-category={app.category_id||''} data-visibility={app.visibility} data-status={app.status} data-complete={missing?'incomplete':'complete'}><label class="admin-app-select"><input type="checkbox" data-app-select value={app.id} aria-label={`Chọn ${app.name}`}/></label><span class:list={['admin-app-health',`is-${health(app)}`]} title={health(app)==='up'?'Đang phản hồi':health(app)==='down'?'Có lỗi':'Chưa kiểm tra'}></span><div class="admin-app-main"><span class="admin-app-icon"><Icon name="grid" size={18}/></span><div><strong>{app.name}</strong><a href={app.production_url} target="_blank" rel="noopener">{app.production_url}</a></div></div><div class="admin-app-meta"><span>{app.category_name||'Chưa phân loại'}</span><span class="badge">{statusLabel(app.status)}</span><span class:list={['admin-visibility',app.visibility==='public'?'is-public':'is-private']}>{app.visibility==='public'?'Public':'Private'}</span>{missing>0&&<span class="admin-missing">Thiếu {missing}</span>}<small>{app.last_checked_at?`HTTP ${app.last_http_status||'—'} · ${app.last_response_ms??'—'} ms`:'Chưa kiểm tra'}</small><form method="post" action={`/api/admin/apps/${app.id}/uptime`}><button class="button ghost small" type="submit">Kiểm tra</button></form><a class="button ghost small" href={`/admin/apps/${app.id}`}>Sửa</a></div></article>})}</div>:<div class="admin-empty-panel"><span><Icon name="grid" size={25}/></span><h2>Chưa có website</h2><p>Kho Toolpick chưa có nội dung. Website đầu tiên có thể được thêm ngay tại đây.</p><a class="button primary" href="/admin/apps/new">+ Thêm website</a></div>}
  <div class="admin-no-results" data-app-empty hidden><strong>Không tìm thấy website phù hợp</strong><span>Thử đổi từ khóa hoặc bộ lọc.</span></div>
  <script is:inline>const q=document.querySelector('[data-app-search]'),c=document.querySelector('[data-app-category]'),v=document.querySelector('[data-app-visibility]'),s=document.querySelector('[data-app-status]'),m=document.querySelector('[data-app-completeness]'),e=document.querySelector('[data-app-empty]'),count=document.querySelector('[data-selected-count]'),bulk=document.querySelector('[data-bulk-form]'),hidden=document.querySelector('[data-bulk-hidden]');const filter=()=>{let shown=0;document.querySelectorAll('[data-app-row]').forEach(r=>{const ok=r.dataset.search.includes((q?.value||'').toLowerCase())&&(!c?.value||r.dataset.category===c.value)&&(!v?.value||r.dataset.visibility===v.value)&&(!s?.value||r.dataset.status===s.value)&&(!m?.value||r.dataset.complete===m.value);r.hidden=!ok;if(ok)shown++});if(e)e.hidden=shown>0};[q,c,v,s,m].forEach(x=>x?.addEventListener('input',filter));document.querySelectorAll('[data-app-select]').forEach(x=>x.addEventListener('change',()=>{const n=document.querySelectorAll('[data-app-select]:checked').length;if(count)count.textContent=String(n)}));bulk?.addEventListener('submit',()=>{if(!hidden)return;hidden.innerHTML='';document.querySelectorAll('[data-app-select]:checked').forEach(x=>{const i=document.createElement('input');i.type='hidden';i.name='ids';i.value=x.value;hidden.appendChild(i)})});</script>
</AdminLayout>
