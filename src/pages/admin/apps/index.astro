---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Icon from '../../../components/Icon.astro';
import { adminApps } from '../../../lib/db';
import { statusLabel,dateLabel } from '../../../lib/utils';
const apps=await adminApps();
const publicCount=apps.filter((a:any)=>a.visibility==='public').length; const privateCount=apps.length-publicCount;
---
<AdminLayout title="Website">
  <section class="admin-section-intro"><div><p class="eyebrow">Kho nội dung</p><h2>Quản lý website</h2><p>{apps.length} website · {publicCount} public · {privateCount} private</p></div><a class="button primary" href="/admin/apps/new">+ Thêm website</a></section>
  <section class="admin-filter-bar"><div class="admin-search-field"><Icon name="search" size={17}/><input data-app-search placeholder="Tìm theo tên hoặc URL..."/></div><select data-app-visibility><option value="">Tất cả quyền xem</option><option value="public">Public</option><option value="private">Private</option></select><select data-app-status><option value="">Tất cả trạng thái</option>{['active','development','beta','paused','archived','offline'].map((s)=><option value={s}>{statusLabel(s)}</option>)}</select></section>
  {apps.length?<div class="admin-app-list">{apps.map((app:any)=><article class="admin-app-row" data-app-row data-search={`${app.name} ${app.production_url}`.toLowerCase()} data-visibility={app.visibility} data-status={app.status}><div class="admin-app-main"><span class="admin-app-icon"><Icon name="grid" size={18}/></span><div><strong>{app.name}</strong><a href={app.production_url} target="_blank" rel="noopener">{app.production_url}</a></div></div><div class="admin-app-meta"><span>{app.category_name||'Chưa phân loại'}</span><span class="badge">{statusLabel(app.status)}</span><span class:list={['admin-visibility',app.visibility==='public'?'is-public':'is-private']}>{app.visibility==='public'?'Public':'Private'}</span><small>{dateLabel(app.updated_at)}</small><a class="button ghost small" href={`/admin/apps/${app.id}`}>Sửa</a></div></article>)}</div>:<div class="admin-empty-panel"><span><Icon name="grid" size={25}/></span><h2>Chưa có website</h2><p>Kho Toolpick chưa có nội dung. Website đầu tiên có thể được thêm ngay tại đây.</p><a class="button primary" href="/admin/apps/new">+ Thêm website</a></div>}
  <div class="admin-no-results" data-app-empty hidden><strong>Không tìm thấy website phù hợp</strong><span>Thử đổi từ khóa hoặc bộ lọc.</span></div>
  <script is:inline>const q=document.querySelector('[data-app-search]'),v=document.querySelector('[data-app-visibility]'),s=document.querySelector('[data-app-status]'),e=document.querySelector('[data-app-empty]');const filter=()=>{let shown=0;document.querySelectorAll('[data-app-row]').forEach(r=>{const ok=r.dataset.search.includes((q?.value||'').toLowerCase())&&(!v?.value||r.dataset.visibility===v.value)&&(!s?.value||r.dataset.status===s.value);r.hidden=!ok;if(ok)shown++});if(e)e.hidden=shown>0};[q,v,s].forEach(x=>x?.addEventListener('input',filter));</script>
</AdminLayout>
