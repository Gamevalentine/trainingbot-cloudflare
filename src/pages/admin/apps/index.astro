---
import AdminLayout from '../../../layouts/AdminLayout.astro'; import { adminApps } from '../../../lib/db'; import { statusLabel,dateLabel } from '../../../lib/utils';
const apps=await adminApps();
---
<AdminLayout title="Website">
  <section class="admin-toolbar admin-toolbar--apps"><div class="admin-list-filters"><input data-app-search placeholder="Tìm tên hoặc URL..."/><select data-app-visibility><option value="">Mọi quyền xem</option><option value="public">Public</option><option value="private">Private</option></select><select data-app-status><option value="">Mọi trạng thái</option>{['active','development','beta','paused','archived','offline'].map((s)=><option value={s}>{statusLabel(s)}</option>)}</select></div><a class="button primary" href="/admin/apps/new">+ Thêm website</a></section>
  <div class="table-wrap"><table><thead><tr><th>Tên</th><th>Danh mục</th><th>Trạng thái</th><th>Quyền xem</th><th>Cập nhật</th><th></th></tr></thead><tbody>{apps.map((app)=><tr data-app-row data-search={`${app.name} ${app.production_url}`.toLowerCase()} data-visibility={app.visibility} data-status={app.status}><td><strong>{app.name}</strong><small>{app.production_url}</small></td><td>{app.category_name||'—'}</td><td><span class="badge">{statusLabel(app.status)}</span></td><td><span class:list={['admin-visibility',app.visibility==='public'?'is-public':'is-private']}>{app.visibility==='public'?'Public':'Private'}</span></td><td>{dateLabel(app.updated_at)}</td><td><a class="button ghost small" href={`/admin/apps/${app.id}`}>Sửa</a></td></tr>)}</tbody></table></div>
  {!apps.length&&<div class="empty-state"><h3>Chưa có website</h3><p>Thêm website đầu tiên để bắt đầu quản lý kho.</p></div>}
  <script is:inline>const q=document.querySelector('[data-app-search]'),v=document.querySelector('[data-app-visibility]'),s=document.querySelector('[data-app-status]');const filter=()=>document.querySelectorAll('[data-app-row]').forEach(r=>{r.hidden=!(r.dataset.search.includes((q?.value||'').toLowerCase())&&(!v?.value||r.dataset.visibility===v.value)&&(!s?.value||r.dataset.status===s.value));});[q,v,s].forEach(x=>x?.addEventListener('input',filter));</script>
</AdminLayout>
