---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminAppForm from '../../../components/AdminAppForm.astro';
import { adminApp, listCategories, listTags } from '../../../lib/db';
import { db } from '../../../lib/cloudflare';
import { sourceArchive } from '../../../lib/admin';
const id=Number(Astro.params.id); const app=await adminApp(id); if(!app)return Astro.redirect('/admin/apps');
const [categories,tags,tagRows,screenshotRows,source]=await Promise.all([
  listCategories(false), listTags(), db().prepare('SELECT tag_id FROM app_tags WHERE app_id=?').bind(id).all<{tag_id:number}>(),
  db().prepare('SELECT id,app_id,r2_key,alt_text,sort_order,created_at FROM screenshots WHERE app_id=? ORDER BY sort_order,id').bind(id).all(), sourceArchive(id)
]);
const selectedTagIds=tagRows.results.map((row)=>row.tag_id); const screenshots=screenshotRows.results as any[];
---
<AdminLayout title={`Sửa: ${app.name}`}>
  {Astro.url.searchParams.get('imported') === '1' && <div class="admin-notice"><strong>Đã phân tích website tự động.</strong><span>Toolpick đã gợi ý tên, mô tả, công dụng, đối tượng, danh mục, tags và tải media nếu website cung cấp. Bản nháp vẫn Private; chỉ cần rà lại rồi bấm Lưu thay đổi.</span></div>}
  {Astro.url.searchParams.get('existing') === '1' && <div class="admin-notice"><strong>Website này đã có trong Toolpick.</strong><span>Không tạo bản trùng. Bạn đang xem bản đã lưu trước đó.</span></div>}
  {Astro.url.searchParams.get('github') === 'ok' && <div class="admin-notice"><strong>GitHub đã đồng bộ.</strong><span>Commit và branch mới nhất đã được cập nhật.</span></div>}
  {Astro.url.searchParams.get('github') === 'error' && <div class="admin-notice admin-notice--danger"><strong>GitHub đồng bộ lỗi.</strong><span>{app.github_sync_error || 'Kiểm tra lại repo.'}</span></div>}
  {app.github_repo && <section class="github-app-panel"><div><p class="eyebrow">GitHub</p><h2>{app.github_repo_full_name || app.github_repo}</h2><p>{app.github_last_commit_message || 'Chưa đồng bộ commit.'}</p></div><div class="github-app-panel__meta"><span>Branch <b>{app.github_default_branch || '—'}</b></span><span>Commit <b>{String(app.github_last_commit_sha||'—').slice(0,7)}</b></span><form method="post" action={`/api/admin/apps/${id}/github`}><button class="button ghost small" type="submit">Đồng bộ GitHub</button></form></div></section>}
  <AdminAppForm app={app} categories={categories} tags={tags} selectedTagIds={selectedTagIds} screenshots={screenshots} source={source}/>
  <section class="danger-zone"><div><h2>Xóa website</h2><p>Xóa metadata, screenshot, icon, cover và source archive của website này.</p></div><form method="post" action={`/api/admin/apps/${id}?_method=DELETE`} onsubmit="return confirm('Xóa vĩnh viễn website này?')"><button class="button danger" type="submit">Xóa website</button></form></section>
</AdminLayout>
