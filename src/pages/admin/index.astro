---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { dashboardStats } from '../../lib/db';
import { statusLabel,dateLabel } from '../../lib/utils';
const stats=await dashboardStats(); const c=stats.counts||{}; const t=stats.traffic||{}; const alerts=(stats as any).alerts||[];
const statCards=[['Tổng website',c.total||0,'grid'],['Public',c.public_count||0,'play'],['Private',c.private_count||0,'folder'],['Hoạt động',c.active_count||0,'check-square'],['Đang phát triển',c.development_count||0,'wrench'],['Có lỗi',c.offline_count||0,'backup']];
---
<AdminLayout title="Tổng quan">
  <section class="admin-overview-head"><div><p class="eyebrow">Tình trạng hệ thống</p><h2>Kho Toolpick hôm nay</h2><p>Theo dõi nhanh nội dung, trạng thái và mức sử dụng của các website.</p></div><a class="button primary" href="/admin/apps/new">+ Thêm website</a></section>
  <section class="admin-stat-grid">{statCards.map(([label,value,icon])=><article><span><Icon name={icon} size={18}/></span><div><small>{label}</small><strong>{value}</strong></div></article>)}</section>
  <section class="admin-action-grid admin-action-grid--four"><a href="/admin/apps"><Icon name="grid" size={19}/><div><strong>Quản lý website</strong><span>Sửa nội dung, quyền xem và trạng thái</span></div><b>→</b></a><a href="/admin/github"><Icon name="code" size={19}/><div><strong>GitHub Sync</strong><span>{c.github_count||0}/{c.total||0} website đã gắn repo</span></div><b>→</b></a><a href="/admin/uptime"><Icon name="heart-pulse" size={19}/><div><strong>Uptime</strong><span>Theo dõi website sống/chết</span></div><b>→</b></a><a href="/admin/backup"><Icon name="backup" size={19}/><div><strong>Backup dữ liệu</strong><span>Xuất hoặc khôi phục metadata</span></div><b>→</b></a></section>
  <section class="admin-alert-panel"><div class="admin-panel-head"><div><p class="eyebrow">Cần chú ý</p><h2>Cảnh báo hệ thống</h2></div><span>{alerts.length} mục</span></div>{alerts.length?<div class="admin-alert-list">{alerts.map((alert:any)=><a class:list={['admin-alert-row',`is-${alert.severity}`]} href={`/admin/apps/${alert.app_id}`}><span>!</span><div><strong>{alert.title}</strong><small>{alert.text}</small></div><b>→</b></a>)}</div>:<div class="admin-empty-compact"><strong>Không có cảnh báo</strong><span>Các website hiện không có vấn đề cần xử lý.</span></div>}</section>
  <section class="admin-dashboard-grid">
    <article class="admin-panel"><div class="admin-panel-head"><div><p class="eyebrow">Gần đây</p><h2>Website mới cập nhật</h2></div><a href="/admin/apps">Xem tất cả</a></div>{stats.recent.length?<div class="admin-recent-list">{stats.recent.map((app:any)=><a href={`/admin/apps/${app.id}`}><div><strong>{app.name}</strong><span>{app.visibility==='public'?'Public':'Private'}</span></div><div><span class="badge">{statusLabel(app.status)}</span><small>{dateLabel(app.updated_at)}</small></div></a>)}</div>:<div class="admin-empty-compact"><strong>Kho đang trống</strong><span>Thêm website đầu tiên để bắt đầu.</span></div>}</article>
    <article class="admin-panel"><div class="admin-panel-head"><div><p class="eyebrow">Sử dụng</p><h2>Lượt truy cập</h2></div><a href="/admin/analytics">Analytics →</a></div><div class="admin-traffic-grid"><div><span>Lượt xem</span><strong>{Number(t.views||0).toLocaleString('vi-VN')}</strong></div><div><span>Lượt mở app</span><strong>{Number(t.opens||0).toLocaleString('vi-VN')}</strong></div></div><div class="admin-popular-head"><strong>Phổ biến nhất</strong><span>Theo lượt mở</span></div>{stats.popular.length?<ol class="admin-popular-list">{stats.popular.map((app:any,i:number)=><li><span><b>{i+1}</b>{app.name}</span><strong>{Number(app.opens).toLocaleString('vi-VN')}</strong></li>)}</ol>:<p class="admin-muted">Chưa có dữ liệu sử dụng.</p>}</article>
  </section>
</AdminLayout>
