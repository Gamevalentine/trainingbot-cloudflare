---
import AdminLayout from '../../layouts/AdminLayout.astro'; import { dashboardStats } from '../../lib/db'; import { statusLabel, dateLabel } from '../../lib/utils'; const stats = await dashboardStats(); const c = stats.counts || {}; const t = stats.traffic || {};
---
<AdminLayout title="Tổng quan"><section class="stat-strip"><div><span>Tổng website</span><strong>{c.total || 0}</strong></div><div><span>Public</span><strong>{c.public_count || 0}</strong></div><div><span>Private</span><strong>{c.private_count || 0}</strong></div><div><span>Đang hoạt động</span><strong>{c.active_count || 0}</strong></div><div><span>Đang phát triển</span><strong>{c.development_count || 0}</strong></div><div><span>Website lỗi</span><strong>{c.offline_count || 0}</strong></div></section><section class="admin-columns"><article><div class="section-heading"><div><p class="eyebrow">Gần đây</p><h2>Website mới cập nhật</h2></div><a href="/admin/apps">Xem tất cả</a></div><div class="admin-list">{stats.recent.map((app:any) => <a href={`/admin/apps/${app.id}`}><div><strong>{app.name}</strong><span>{app.visibility}</span></div><div><span class="badge">{statusLabel(app.status)}</span><small>{dateLabel(app.updated_at)}</small></div></a>)}</div></article><article><div class="section-heading"><div><p class="eyebrow">Sử dụng</p><h2>Tổng truy cập</h2></div></div><div class="traffic-numbers"><div><span>Lượt xem</span><strong>{Number(t.views || 0).toLocaleString('vi-VN')}</strong></div><div><span>Lượt mở app</span><strong>{Number(t.opens || 0).toLocaleString('vi-VN')}</strong></div></div><h3>Phổ biến nhất</h3><ol class="popular-list">{stats.popular.map((app:any) => <li><span>{app.name}</span><strong>{Number(app.opens).toLocaleString('vi-VN')}</strong></li>)}</ol></article></section></AdminLayout>
