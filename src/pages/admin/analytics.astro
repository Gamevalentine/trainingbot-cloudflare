---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { analyticsReport } from '../../lib/db';
const days=Astro.url.searchParams.get('days')==='30'?30:7;
const report=await analyticsReport(days); const s=report.summary;
const fmt=(value:any)=>Number(value||0).toLocaleString('vi-VN');
const dayFmt=new Intl.DateTimeFormat('vi-VN',{day:'2-digit',month:'2-digit'});
const publicTotal=(row:any)=>Number(row.views||0)+Number(row.opens||0)+Number(row.searches||0)+Number(row.category_views||0);
const maxPublic=Math.max(1,...report.daily.map(publicTotal));
const maxAdmin=Math.max(1,...report.daily.map((row:any)=>Number(row.admin_actions||0)));
const adminLabel=(key:string)=>key.replace('POST /api/admin/apps/:id/github','Đồng bộ GitHub').replace('POST /api/admin/uptime/check-all','Kiểm tra toàn bộ uptime').replace('POST /api/admin/github/sync-all','Đồng bộ toàn bộ GitHub').replace('POST /api/admin/apps','Tạo website').replace('POST /api/admin/categories','Tạo danh mục').replace('POST /api/admin/tags','Tạo tag').replace('POST /api/admin/','Cập nhật ').replace('DELETE /api/admin/','Xóa ');
---
<AdminLayout title="Analytics">
  <section class="admin-section-intro analytics-intro"><div><p class="eyebrow">Sử dụng thực tế</p><h2>Analytics Toolpick</h2><p>Xu hướng truy cập công khai và hoạt động quản trị, không lưu IP hay dữ liệu cá nhân.</p></div><div class="analytics-range"><a class:list={['button','ghost',days===7&&'active']} href="/admin/analytics?days=7">7 ngày</a><a class:list={['button','ghost',days===30&&'active']} href="/admin/analytics?days=30">30 ngày</a></div></section>
  <section class="analytics-stat-grid">
    <article><span><Icon name="grid" size={18}/></span><div><small>Lượt xem app</small><strong>{fmt(s.views)}</strong></div></article>
    <article><span><Icon name="play" size={18}/></span><div><small>Mở ứng dụng</small><strong>{fmt(s.opens)}</strong></div></article>
    <article><span><Icon name="search" size={18}/></span><div><small>Lượt tìm kiếm</small><strong>{fmt(s.searches)}</strong></div></article>
    <article><span><Icon name="search" size={18}/></span><div><small>Không có kết quả</small><strong>{fmt(s.zero_results)}</strong></div></article>
    <article><span><Icon name="folder" size={18}/></span><div><small>Xem danh mục</small><strong>{fmt(s.category_views)}</strong></div></article>
    <article><span><Icon name="settings" size={18}/></span><div><small>Admin activity</small><strong>{fmt(s.admin_actions)}</strong></div></article>
  </section>
  <section class="analytics-chart-card">
    <div class="admin-panel-head"><div><p class="eyebrow">Xu hướng</p><h2>{days} ngày gần nhất</h2></div><div class="analytics-legend"><span><i class="is-public"></i>Public traffic</span><span><i class="is-admin"></i>Admin activity</span></div></div>
    <div class:list={['analytics-chart',days===30&&'is-30']}>
      {report.daily.map((row:any)=><div class="analytics-day"><div class="analytics-bars"><span class="analytics-bar is-public" style={`height:${Math.max(3,publicTotal(row)/maxPublic*100)}%`} title={`Public: ${fmt(publicTotal(row))}`}></span><span class="analytics-bar is-admin" style={`height:${Number(row.admin_actions||0)?Math.max(3,Number(row.admin_actions)/maxAdmin*100):0}%`} title={`Admin: ${fmt(row.admin_actions)}`}></span></div><small>{dayFmt.format(new Date(`${row.date}T00:00:00Z`))}</small></div>)}
    </div>
    <div class="analytics-chart-note">Public traffic = lượt xem app + mở ứng dụng + tìm kiếm + xem danh mục.</div>
  </section>

  <section class="analytics-two-col">
    <article class="admin-panel analytics-ranking"><div class="admin-panel-head"><div><p class="eyebrow">Website</p><h2>Xem nhiều nhất</h2></div></div>{report.topViews.length?<ol>{report.topViews.map((row:any,i:number)=><li><span><b>{i+1}</b><a href={`/admin/apps/${row.id}`}>{row.name}</a></span><strong>{fmt(row.value)}</strong></li>)}</ol>:<p class="admin-muted">Chưa có lượt xem trong khoảng này.</p>}</article>
    <article class="admin-panel analytics-ranking"><div class="admin-panel-head"><div><p class="eyebrow">Website</p><h2>Được mở nhiều nhất</h2></div></div>{report.topOpens.length?<ol>{report.topOpens.map((row:any,i:number)=><li><span><b>{i+1}</b><a href={`/admin/apps/${row.id}`}>{row.name}</a></span><strong>{fmt(row.value)}</strong></li>)}</ol>:<p class="admin-muted">Chưa có lượt mở trong khoảng này.</p>}</article>
  </section>

  <section class="analytics-two-col">
    <article class="admin-panel analytics-ranking"><div class="admin-panel-head"><div><p class="eyebrow">Nhu cầu</p><h2>Từ khóa tìm nhiều</h2></div></div>{report.topSearches.length?<ol>{report.topSearches.map((row:any,i:number)=><li><span><b>{i+1}</b><span>{row.query}</span>{Number(row.zero_results)>0&&<small>{fmt(row.zero_results)} lần không có kết quả</small>}</span><strong>{fmt(row.value)}</strong></li>)}</ol>:<p class="admin-muted">Từ khóa sẽ bắt đầu được ghi từ bản Analytics này.</p>}</article>
    <article class="admin-panel analytics-ranking"><div class="admin-panel-head"><div><p class="eyebrow">Danh mục</p><h2>Được xem nhiều</h2></div></div>{report.topCategories.length?<ol>{report.topCategories.map((row:any,i:number)=><li><span><b>{i+1}</b><span>{row.name}</span></span><strong>{fmt(row.value)}</strong></li>)}</ol>:<p class="admin-muted">Lượt xem danh mục sẽ bắt đầu được ghi từ bản Analytics này.</p>}</article>
  </section>
  <section class="admin-panel analytics-ranking analytics-admin-activity">
    <div class="admin-panel-head"><div><p class="eyebrow">Owner Console</p><h2>Admin activity</h2></div><span>{fmt(s.admin_actions)} thao tác</span></div>
    {report.topAdmin.length?<ol>{report.topAdmin.map((row:any,i:number)=><li><span><b>{i+1}</b><span>{adminLabel(row.event_key)}</span></span><strong>{fmt(row.value)}</strong></li>)}</ol>:<p class="admin-muted">Các thao tác ghi dữ liệu trong Admin sẽ được thống kê từ bản này trở đi.</p>}
  </section>
</AdminLayout>
