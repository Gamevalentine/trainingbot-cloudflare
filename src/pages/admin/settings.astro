---
import AdminLayout from '../../layouts/AdminLayout.astro'; import { env } from 'cloudflare:workers';
const passwordReady=true; const sessionReady=String(env.ADMIN_SESSION_SECRET||'').length>=32;
---
<AdminLayout title="Cài đặt">
  <section class="settings-grid"><article class="setting-panel"><p class="eyebrow">Hệ thống</p><h2>Toolpick</h2><dl class="meta-list"><div><dt>Site URL</dt><dd>{String(env.SITE_URL||'Chưa cấu hình')}</dd></div><div><dt>Database</dt><dd>D1 · DB</dd></div><div><dt>Media</dt><dd>R2 · MEDIA</dd></div><div><dt>Admin protection</dt><dd>Mật khẩu + session HMAC</dd></div></dl></article>
  <article class="setting-panel"><p class="eyebrow">Bảo mật</p><h2>Trạng thái đăng nhập</h2><div class="security-checks"><div class:list={[passwordReady?'ok':'missing']}><span>{passwordReady?'✓':'!'}</span><strong>Admin password</strong><small>{passwordReady?'Đã cấu hình hash cục bộ':'Chưa cấu hình'}</small></div><div class:list={[sessionReady?'ok':'missing']}><span>{sessionReady?'✓':'!'}</span><strong>Session signing</strong><small>{sessionReady?'HMAC secret đã cấu hình':'Chưa cấu hình'}</small></div><div class="ok"><span>✓</span><strong>Session cookie</strong><small>HttpOnly · Secure · SameSite=Strict · 12 giờ</small></div></div><p>Admin URL, GitHub repo, Cloudflare project và source archive không xuất hiện trên public pages.</p></article></section>
</AdminLayout>
