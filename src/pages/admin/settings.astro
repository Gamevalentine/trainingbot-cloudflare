---
import AdminLayout from '../../layouts/AdminLayout.astro'; import { env } from 'cloudflare:workers';
const accessRequired=String(env.REQUIRE_ACCESS||'true')!=='false'; const ownerReady=Boolean(String(env.OWNER_EMAIL||'').trim()); const teamReady=Boolean(String(env.ACCESS_TEAM_DOMAIN||'').trim()); const audReady=Boolean(String(env.ACCESS_AUD||'').trim());
---
<AdminLayout title="Cài đặt">
  <section class="settings-grid"><article class="setting-panel"><p class="eyebrow">Hệ thống</p><h2>Toolpick</h2><dl class="meta-list"><div><dt>Site URL</dt><dd>{String(env.SITE_URL||'Chưa cấu hình')}</dd></div><div><dt>Database</dt><dd>D1 · DB</dd></div><div><dt>Media</dt><dd>R2 · MEDIA</dd></div><div><dt>Admin protection</dt><dd>{accessRequired?'Cloudflare Access':'Tắt (chỉ dev)'}</dd></div></dl></article>
  <article class="setting-panel"><p class="eyebrow">Bảo mật</p><h2>Trạng thái Access</h2><div class="security-checks"><div class:list={[ownerReady?'ok':'missing']}><span>{ownerReady?'✓':'!'}</span><strong>Owner identity</strong><small>{ownerReady?'Đã cấu hình':'Chưa cấu hình'}</small></div><div class:list={[teamReady?'ok':'missing']}><span>{teamReady?'✓':'!'}</span><strong>Team domain</strong><small>{teamReady?'Đã cấu hình':'Chưa cấu hình'}</small></div><div class:list={[audReady?'ok':'missing']}><span>{audReady?'✓':'!'}</span><strong>Access audience</strong><small>{audReady?'Đã cấu hình':'Chưa cấu hình'}</small></div></div><p>Admin URL, GitHub repo, Cloudflare project và source archive không xuất hiện trên public pages.</p></article></section>
</AdminLayout>
