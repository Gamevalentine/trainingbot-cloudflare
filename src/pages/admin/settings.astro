---
import AdminLayout from '../../layouts/AdminLayout.astro'; import { env } from 'cloudflare:workers';
---
<AdminLayout title="Cài đặt">
  <section class="settings-grid"><article class="setting-panel"><p class="eyebrow">Hệ thống</p><h2>Toolpick</h2><dl class="meta-list"><div><dt>Site URL</dt><dd>{String(env.SITE_URL||'Chưa cấu hình')}</dd></div><div><dt>Database</dt><dd>D1 · DB</dd></div><div><dt>Media</dt><dd>R2 · MEDIA</dd></div><div><dt>Admin protection</dt><dd>Mật khẩu + D1 session token</dd></div></dl></article>
  <article class="setting-panel"><p class="eyebrow">Bảo mật</p><h2>Trạng thái đăng nhập</h2><div class="security-checks"><div class="ok"><span>✓</span><strong>Admin password</strong><small>SHA-256 hash đã cấu hình</small></div><div class="ok"><span>✓</span><strong>Session store</strong><small>Token ngẫu nhiên, chỉ lưu hash trong D1</small></div><div class="ok"><span>✓</span><strong>Session cookie</strong><small>HttpOnly · Secure · SameSite=Strict · 12 giờ</small></div></div><p>Admin URL, GitHub repo, Cloudflare project và source archive không xuất hiện trên public pages.</p></article></section>
</AdminLayout>
