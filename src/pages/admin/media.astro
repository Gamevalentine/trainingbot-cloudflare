---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { db } from '../../lib/cloudflare';
const apps=(await db().prepare(`SELECT id,name,icon_key,cover_key FROM apps WHERE icon_key<>'' OR cover_key<>'' ORDER BY updated_at DESC`).all()).results as any[];
const shots=(await db().prepare(`SELECT s.id,s.app_id,s.r2_key,s.alt_text,s.created_at,a.name app_name FROM screenshots s JOIN apps a ON a.id=s.app_id ORDER BY s.created_at DESC LIMIT 200`).all()).results as any[];
const items:any[]=[]; for(const app of apps){if(app.icon_key)items.push({key:app.icon_key,app_id:app.id,app_name:app.name,type:'Icon',kind:'icon'});if(app.cover_key)items.push({key:app.cover_key,app_id:app.id,app_name:app.name,type:'Cover',kind:'cover'});} for(const shot of shots)items.push({key:shot.r2_key,app_id:shot.app_id,app_name:shot.app_name,type:'Screenshot',screen:shot.id,alt:shot.alt_text});
const iconCount=items.filter(x=>x.type==='Icon').length, coverCount=items.filter(x=>x.type==='Cover').length, shotCount=items.filter(x=>x.type==='Screenshot').length;
---
<AdminLayout title="Media">
  <section class="admin-section-intro"><div><p class="eyebrow">R2 Media</p><h2>Thư viện hình ảnh</h2><p>{items.length} file đang được dùng · {iconCount} icon · {coverCount} cover · {shotCount} screenshot</p></div><a class="button ghost" href="/admin/apps">Quản lý website</a></section>
  {items.length?<div class="media-library-grid">{items.map((item:any)=><article class="media-library-card"><a class="media-library-preview" href={`/media/${item.key}`} target="_blank"><img src={`/media/${item.key}`} alt={item.alt||`${item.type} ${item.app_name}`}/></a><div class="media-library-body"><div class="media-library-title"><span class="badge">{item.type}</span><strong>{item.app_name}</strong></div><small title={item.alt||item.key}>{item.alt||item.key}</small><div class="media-library-actions"><a href={`/admin/apps/${item.app_id}`}>Mở website</a><form method="post" action={`/api/admin/media/${encodeURIComponent(item.key)}?_method=DELETE&${item.screen?`screen=${item.screen}`:`app=${item.app_id}&kind=${item.kind}`}&back=/admin/media`} onsubmit="return confirm('Xóa file này khỏi R2?')"><button class="text-danger" type="submit">Xóa</button></form></div></div></article>)}</div>:<div class="admin-empty-panel"><span><Icon name="media" size={25}/></span><h2>Chưa có media</h2><p>Icon, cover và screenshot được upload trong màn hình sửa website sẽ xuất hiện ở đây.</p><a class="button primary" href="/admin/apps">Đi tới Website</a></div>}
</AdminLayout>
