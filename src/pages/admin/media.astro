---
import AdminLayout from '../../layouts/AdminLayout.astro'; import { db } from '../../lib/cloudflare';
const apps=(await db().prepare(`SELECT id,name,icon_key,cover_key FROM apps WHERE icon_key<>'' OR cover_key<>'' ORDER BY updated_at DESC`).all()).results as any[];
const shots=(await db().prepare(`SELECT s.id,s.app_id,s.r2_key,s.alt_text,s.created_at,a.name app_name FROM screenshots s JOIN apps a ON a.id=s.app_id ORDER BY s.created_at DESC LIMIT 200`).all()).results as any[];
const items:any[]=[]; for(const app of apps){if(app.icon_key)items.push({key:app.icon_key,app_id:app.id,app_name:app.name,type:'Icon',kind:'icon'});if(app.cover_key)items.push({key:app.cover_key,app_id:app.id,app_name:app.name,type:'Cover',kind:'cover'});} for(const shot of shots)items.push({key:shot.r2_key,app_id:shot.app_id,app_name:shot.app_name,type:'Screenshot',screen:shot.id,alt:shot.alt_text});
---
<AdminLayout title="Media">
  <div class="admin-toolbar"><div><strong>{items.length} file đang được dùng</strong><p class="admin-muted">Icon, cover và screenshot công khai trên R2.</p></div><a class="button ghost" href="/admin/apps">Quản lý website</a></div>
  {items.length?<div class="media-admin-grid">{items.map((item)=><article><img src={`/media/${item.key}`} alt={item.alt||`${item.type} ${item.app_name}`}/><div><span class="badge">{item.type}</span><strong>{item.app_name}</strong><small>{item.alt||item.key}</small><form method="post" action={`/api/admin/media/${encodeURIComponent(item.key)}?_method=DELETE&${item.screen?`screen=${item.screen}`:`app=${item.app_id}&kind=${item.kind}`}&back=/admin/media`} onsubmit="return confirm('Xóa file này khỏi R2?')"><button class="text-danger" type="submit">Xóa media</button></form></div></article>)}</div>:<div class="empty-state"><h3>Chưa có media</h3><p>Upload icon, cover hoặc screenshot trong màn hình sửa website.</p></div>}
</AdminLayout>
