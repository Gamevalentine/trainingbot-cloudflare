---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { db } from '../../lib/cloudflare';
const categories=(await db().prepare(`SELECT c.*,COUNT(a.id) app_count FROM categories c LEFT JOIN apps a ON a.category_id=c.id GROUP BY c.id ORDER BY c.sort_order,c.name`).all()).results as any[];
---
<AdminLayout title="Danh mục">
  <section class="category-manager">
    <form class="setting-panel category-create" method="post" action="/api/admin/categories">
      <div class="category-create__head"><div><p class="eyebrow">Danh mục mới</p><h2>Thêm danh mục</h2></div><span>{categories.length} danh mục</span></div>
      <p class="category-create__copy">Nhóm các công cụ theo chủ đề để tìm và lọc nhanh.</p>
      <label>Tên<input name="name" required placeholder="Ví dụ: Y khoa"/></label>
      <label>Slug<input name="slug" placeholder="Tự tạo nếu để trống"/></label>
      <label>Mô tả<textarea name="description" rows="3" placeholder="Mô tả ngắn về nhóm công cụ"></textarea></label>
      <div class="field-grid"><label>Icon<input name="icon" value="folder"/></label><label>Thứ tự<input type="number" name="sort_order" value="0"/></label></div>
      <button class="button primary" type="submit">+ Thêm danh mục</button>
    </form>
    <div class="category-list-panel">
      <div class="category-list-heading"><div><p class="eyebrow">Đang quản lý</p><h2>Danh sách danh mục</h2></div><span>{categories.length} mục</span></div>
      <div class="category-list">
        {categories.map((c)=><details class="category-row">
          <summary>
            <div class="category-row__identity"><span class="category-row__icon"><Icon name={c.icon || 'folder'} size={17}/></span><div><strong>{c.name}</strong><small>/{c.slug}</small></div></div>
            <div class="category-row__meta"><span><b>{c.app_count}</b> website</span><span class:list={['category-status',c.is_active===1?'is-active':'is-hidden']}>{c.is_active===1?'Hiển thị':'Đang ẩn'}</span><span class="category-order">#{c.sort_order}</span><span class="category-edit-label">Sửa</span></div>
          </summary>
          <form class="category-edit-form" method="post" action={`/api/admin/categories/${c.id}`}>
            <div class="category-form-grid"><label>Tên<input name="name" value={c.name} required/></label><label>Slug<input name="slug" value={c.slug} required/></label></div>
            <label>Mô tả<textarea name="description" rows="2" placeholder="Mô tả danh mục">{c.description}</textarea></label>
            <div class="category-form-grid category-form-grid--bottom"><label>Icon<input name="icon" value={c.icon}/></label><label>Thứ tự<input type="number" name="sort_order" value={c.sort_order}/></label><label class="category-visible"><input type="checkbox" name="is_active" value="1" checked={c.is_active===1}/><span>Hiển thị danh mục</span></label></div>
            <div class="category-edit-actions"><button class="button small" type="submit">Lưu thay đổi</button><button class="button danger small" formmethod="post" formaction={`/api/admin/categories/${c.id}?_method=DELETE`} onclick="return confirm('Xóa danh mục? Website bên trong sẽ chuyển về chưa phân loại.')">Xóa</button></div>
          </form>
        </details>)}
      </div>
    </div>
  </section>
</AdminLayout>
