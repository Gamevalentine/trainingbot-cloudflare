---
import AdminLayout from '../../layouts/AdminLayout.astro'; import { listCategories } from '../../lib/db'; const categories = await listCategories(false);
---
<AdminLayout title="Danh mục"><section class="split-admin"><form class="setting-panel" method="post" action="/api/admin/categories"><p class="eyebrow">Danh mục mới</p><h2>Thêm danh mục</h2><label>Tên<input name="name" required /></label><label>Slug<input name="slug" /></label><label>Mô tả<textarea name="description" rows="3"></textarea></label><label>Icon<input name="icon" value="folder" /></label><label>Thứ tự<input type="number" name="sort_order" value="0" /></label><button class="button primary" type="submit">Thêm</button></form><div class="stack-list">{categories.map((c) => <form class="inline-edit" method="post" action={`/api/admin/categories/${c.id}`}><input name="name" value={c.name} required/><input name="slug" value={c.slug} required/><input name="icon" value={c.icon}/><input type="number" name="sort_order" value={c.sort_order}/><label class="checkbox-row"><input type="checkbox" name="is_active" value="1" checked={c.is_active===1}/> Hiện</label><button class="button small" type="submit">Lưu</button><button class="button danger small" formmethod="post" formaction={`/api/admin/categories/${c.id}?_method=DELETE`} onclick="return confirm('Xóa danh mục?')">Xóa</button></form>)}</div></section></AdminLayout>
