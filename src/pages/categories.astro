---
import PublicLayout from '../layouts/PublicLayout.astro'; import Icon from '../components/Icon.astro'; import { listCategories } from '../lib/db'; const categories=(await listCategories()).filter(c=>(c.app_count||0)>0);
---
<PublicLayout title="Danh mục · Toolpick" description="Khám phá công cụ theo danh mục."><section class="container page-hero"><p class="eyebrow">Danh mục</p><h1>Khám phá theo nhóm công cụ</h1><p>Các nhóm được quản lý động trong Owner Console.</p></section><section class="container category-grid large">{categories.map(c=><a class="category-card" href={`/category/${c.slug}`}><span class="category-icon"><Icon name={c.icon}/></span><div><h2>{c.name}</h2><p>{c.description||`${c.app_count||0} công cụ`}</p></div><strong>{c.app_count||0}</strong></a>)}</section></PublicLayout>
