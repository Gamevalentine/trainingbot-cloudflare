---
import PublicLayout from '../../layouts/PublicLayout.astro';
import AppGrid from '../../components/AppGrid.astro';
import Icon from '../../components/Icon.astro';
import { getPublicApp, incrementMetric, relatedApps } from '../../lib/db';
import { dateLabel, featureList, mediaUrl, statusLabel } from '../../lib/utils';

const slug=Astro.params.slug!;
const app=await getPublicApp(slug);
if(!app) return new Response('Không tìm thấy',{status:404});
await incrementMetric(app.id,'views').catch(()=>{});
const related=await relatedApps(app,4);
const features=featureList(app.features);
const image=app.cover_key?mediaUrl(app.cover_key):undefined;
const host=(()=>{try{return new URL(app.production_url).hostname.replace(/^www\./,'');}catch{return app.production_url;}})();
const pricingLabel=({free:'Miễn phí',freemium:'Miễn phí + trả phí',paid:'Trả phí',subscription:'Thuê bao'} as Record<string,string>)[app.pricing_type]||app.pricing_type||'Chưa rõ';
const statusTone=app.status==='active'?'good':app.status==='offline'?'bad':'warn';
const checked=app.last_checked_at?dateLabel(app.last_checked_at):'Chưa kiểm tra';
const structuredData={'@context':'https://schema.org','@graph':[{'@type':'SoftwareApplication',name:app.name,description:app.short_description||app.description,url:app.production_url,applicationCategory:'WebApplication',operatingSystem:app.platform||'Web',isAccessibleForFree:app.pricing_type==='free',publisher:{'@type':'Organization',name:'Toolpick',url:'https://toolpick.id.vn/' }},{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Trang chủ',item:'https://toolpick.id.vn/'},{'@type':'ListItem',position:2,name:app.category_name||'Danh mục',item:`https://toolpick.id.vn/category/${app.category_slug||''}`},{'@type':'ListItem',position:3,name:app.name,item:`https://toolpick.id.vn/apps/${app.slug}`}]}]};
---
<PublicLayout title={`${app.name} · Toolpick`} description={app.short_description||app.description} image={image} structuredData={structuredData}>
  <section class="container detail-hero-v2">
    <div class="detail-intro">
      <a class="detail-breadcrumb" href={app.category_slug?`/category/${app.category_slug}`:'/categories'}>{app.category_name||'Công cụ web'} <span>›</span></a>
      <div class="detail-identity">
        {app.icon_key?<img class="detail-icon-v2" src={mediaUrl(app.icon_key)} alt=""/>:<div class="detail-icon-v2 app-icon--fallback">{app.name[0]}</div>}
        <div><h1>{app.name}</h1><p>{app.short_description||app.primary_use||app.description}</p></div>
      </div>
      <div class="detail-signal-row">
        <span class:list={['detail-status',`is-${statusTone}`]}><i></i>{statusLabel(app.status)}</span>
        <span>{host}</span>
        <span>{pricingLabel}</span>
        <span>{app.platform||'Web'}</span>
      </div>
      <div class="detail-actions-v2">
        <a class="button primary large" href={`/go/${app.slug}`} target="_blank" rel="noopener">Mở công cụ <span>↗</span></a>
        <button class="button ghost large favorite-detail" type="button" data-favorite-toggle data-slug={app.slug}><Icon name="heart" size={19}/> Yêu thích</button>
      </div>
      {app.status==='offline'&&<p class="detail-warning">Website đang được ghi nhận là không hoạt động. Bạn vẫn có thể thử mở để kiểm tra.</p>}
    </div>
    <div class="detail-preview">
      {app.cover_key?<img src={mediaUrl(app.cover_key)} alt={`Ảnh xem trước ${app.name}`}/>:<div class="detail-preview-empty"><span>{app.name}</span><small>Chưa có ảnh xem trước</small></div>}
    </div>
  </section>
  <section class="container detail-summary-grid">
    <article><span>Dùng để làm gì</span><strong>{app.primary_use||app.description||'Chưa có mô tả công dụng.'}</strong></article>
    <article><span>Phù hợp với ai</span><strong>{app.audience||'Người dùng cần công cụ này.'}</strong></article>
    <article><span>Tình trạng</span><strong>{statusLabel(app.status)}</strong><small>Kiểm tra gần nhất: {checked}{app.last_http_status?` · HTTP ${app.last_http_status}`:''}</small></article>
  </section>

  <section class="container detail-body-v2">
    <div class="detail-copy-v2">
      {app.description&&<article><p class="eyebrow">Tổng quan</p><h2>Về {app.name}</h2><p class="prose preserve-lines">{app.description}</p></article>}
      {features.length>0&&<article><p class="eyebrow">Khả năng chính</p><h2>Tính năng nổi bật</h2><ul class="feature-list-v2">{features.map(x=><li><span>✓</span><p>{x}</p></li>)}</ul></article>}
      {app.screenshots&&app.screenshots.length>0&&<article><p class="eyebrow">Hình ảnh</p><h2>Xem trước giao diện</h2><div class="screenshot-grid">{app.screenshots.map((s:any)=><img src={mediaUrl(s.r2_key)} alt={s.alt_text||app.name} loading="lazy"/>)}</div></article>}
    </div>

    <aside class="detail-sidebar-v2">
      <div class="detail-info-card">
        <p class="eyebrow">Thông tin nhanh</p>
        <dl>
          <div><dt>Website</dt><dd>{host}</dd></div>
          <div><dt>Danh mục</dt><dd>{app.category_name||'—'}</dd></div>
          <div><dt>Nền tảng</dt><dd>{app.platform||'Web'}</dd></div>
          <div><dt>Chi phí</dt><dd>{pricingLabel}</dd></div>
          <div><dt>Phiên bản</dt><dd>{app.version||'—'}</dd></div>
          <div><dt>Cập nhật</dt><dd>{dateLabel(app.updated_at)}</dd></div>
          {app.tech_stack&&<div><dt>Công nghệ</dt><dd>{app.tech_stack}</dd></div>}
        </dl>
        {app.tags&&app.tags.length>0&&<div class="tag-list detail-tags">{app.tags.map((t:any)=><span>{t.name}</span>)}</div>}
        <a class="button primary detail-sidebar-cta" href={`/go/${app.slug}`} target="_blank" rel="noopener">Mở {app.name} ↗</a>
      </div>
    </aside>
  </section>

  {related.length>0&&<section class="container section-block detail-related"><div class="section-heading"><div><p class="eyebrow">Công cụ tương tự</p><h2>Có thể bạn cũng cần</h2></div><a href={app.category_slug?`/category/${app.category_slug}`:'/explore'}>Xem thêm</a></div><AppGrid apps={related}/></section>}
</PublicLayout>

<style>
  .detail-hero-v2{padding:62px 0 34px;display:grid;grid-template-columns:minmax(0,1fr) minmax(420px,.9fr);gap:54px;align-items:center}
  .detail-intro{min-width:0}.detail-breadcrumb{display:inline-flex;gap:7px;align-items:center;margin-bottom:24px;color:var(--muted);font-size:13px;font-weight:650}.detail-breadcrumb:hover{color:var(--brand)}
  .detail-identity{display:flex;gap:18px;align-items:flex-start}.detail-identity>div{min-width:0}.detail-identity p{overflow-wrap:anywhere}.detail-icon-v2{width:72px;height:72px;flex:0 0 72px;border-radius:18px;object-fit:cover}
  .detail-identity h1{font-size:clamp(40px,5vw,62px);margin:0 0 12px}.detail-identity p{max-width:690px;margin:0;color:var(--muted);font-size:18px;line-height:1.65}
  .detail-signal-row{display:flex;flex-wrap:wrap;gap:9px;margin-top:24px}.detail-signal-row>span{display:inline-flex;align-items:center;gap:7px;padding:7px 10px;border:1px solid var(--border);border-radius:999px;background:var(--surface);font-size:12px;color:var(--muted)}
  .detail-status i{width:7px;height:7px;border-radius:50%;background:var(--warning)}.detail-status.is-good i{background:var(--success)}.detail-status.is-bad i{background:var(--danger)}
  .detail-actions-v2{display:flex;gap:10px;margin-top:28px}.detail-warning{margin:14px 0 0;color:var(--danger);font-size:13px}
  .detail-preview{border:1px solid var(--border);border-radius:22px;overflow:hidden;background:var(--surface);box-shadow:var(--shadow)}.detail-preview>img{width:100%;aspect-ratio:16/10;object-fit:cover}
  .detail-preview-empty{aspect-ratio:16/10;display:grid;place-items:center;align-content:center;gap:8px;background:linear-gradient(145deg,var(--surface-2),var(--surface));color:var(--muted)}.detail-preview-empty span{font-size:30px;font-weight:800;color:var(--text)}
  .detail-summary-grid{display:grid;grid-template-columns:1.2fr 1.2fr .8fr;border-block:1px solid var(--border)}
  .detail-summary-grid article{padding:24px 26px;border-right:1px solid var(--border)}.detail-summary-grid article:last-child{border-right:0}.detail-summary-grid span{display:block;margin-bottom:8px;color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.08em;font-weight:750}
  .detail-summary-grid strong{display:block;font-size:15px;line-height:1.55}.detail-summary-grid small{display:block;margin-top:6px;color:var(--muted);font-size:11px}
  .detail-body-v2{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:70px;padding:48px 0 74px}
  .detail-copy-v2 article{padding:0 0 38px;margin-bottom:38px;border-bottom:1px solid var(--border)}.detail-copy-v2 article:last-child{margin-bottom:0}.detail-copy-v2 h2{margin-bottom:15px}
  .feature-list-v2{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:1fr 1fr;gap:12px}.feature-list-v2 li{display:flex;gap:10px;padding:14px;border:1px solid var(--border);border-radius:12px;background:var(--surface)}
  .feature-list-v2 li>span{width:23px;height:23px;flex:0 0 23px;display:grid;place-items:center;border-radius:50%;background:color-mix(in srgb,var(--success) 12%,var(--surface));color:var(--success);font-weight:800}.feature-list-v2 p{margin:0;line-height:1.55}
  .detail-sidebar-v2{align-self:start}.detail-info-card{position:sticky;top:94px;padding:22px;border:1px solid var(--border);border-radius:16px;background:var(--surface)}
  .detail-info-card dl{margin:0}.detail-info-card dl>div{display:flex;justify-content:space-between;gap:20px;padding:11px 0;border-bottom:1px solid var(--border)}.detail-info-card dt{color:var(--muted)}.detail-info-card dd{max-width:58%;margin:0;text-align:right;overflow-wrap:anywhere}
  .detail-tags{margin:18px 0}.detail-sidebar-cta{width:100%;margin-top:18px}.detail-related{border-top:1px solid var(--border)}
  @media(max-width:900px){.detail-hero-v2{grid-template-columns:1fr;gap:30px}.detail-summary-grid{grid-template-columns:1fr}.detail-summary-grid article{border-right:0;border-bottom:1px solid var(--border)}.detail-summary-grid article:last-child{border-bottom:0}.detail-body-v2{grid-template-columns:1fr;gap:30px}.detail-sidebar-v2{order:-1}.detail-info-card{position:static}.feature-list-v2{grid-template-columns:1fr}}
  @media(max-width:520px){.detail-hero-v2{padding-top:38px}.detail-breadcrumb{margin-bottom:18px}.detail-identity{align-items:center}.detail-icon-v2{width:58px;height:58px;flex-basis:58px;border-radius:14px}.detail-identity h1{font-size:35px}.detail-identity p{font-size:16px}.detail-actions-v2{display:grid}.detail-actions-v2 .button{width:100%}.detail-summary-grid article{padding:20px 4px}.detail-body-v2{padding-top:32px}.detail-info-card{padding:18px}.detail-copy-v2 article{padding-bottom:30px;margin-bottom:30px}}
</style>
