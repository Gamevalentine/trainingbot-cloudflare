---
import PublicLayout from '../../layouts/PublicLayout.astro'; import AppGrid from '../../components/AppGrid.astro'; import { getPublicApp, incrementMetric, relatedApps } from '../../lib/db'; import { dateLabel, featureList, mediaUrl, statusLabel } from '../../lib/utils';
const slug=Astro.params.slug!; const app=await getPublicApp(slug); if(!app) return new Response('Không tìm thấy',{status:404}); Astro.defer?.(()=>incrementMetric(app.id,'views').catch(()=>{})); const related=await relatedApps(app,4); const features=featureList(app.features); const image=app.cover_key?mediaUrl(app.cover_key):undefined; const structuredData={'@context':'https://schema.org','@type':'SoftwareApplication',name:app.name,description:app.short_description||app.description,url:app.production_url,applicationCategory:app.category_name||'WebApplication',operatingSystem:app.platform||'Web',isAccessibleForFree:app.pricing_type==='free'};
---
<PublicLayout title={`${app.name} · Web Tools Hub`} description={app.short_description||app.description} image={image} structuredData={structuredData}><section class="container app-detail-hero"><div class="detail-main"><div class="detail-title">{app.icon_key?<img class="detail-icon" src={mediaUrl(app.icon_key)} alt=""/>:<div class="detail-icon app-icon--fallback">{app.name[0]}</div>}<div><p class="eyebrow">{app.category_name||'Công cụ web'}</p><h1>{app.name}</h1><p>{app.short_description}</p></div></div><div class="detail-actions"><a class="button primary large" href={`/go/${app.slug}`} target="_blank" rel="noopener">Mở ứng dụng ↗</a><span class="badge">{statusLabel(app.status)}</span></div></div>{app.cover_key?<img class="detail-cover" src={mediaUrl(app.cover_key)} alt={`Ảnh xem trước ${app.name}`}/>:<div class="detail-cover detail-cover--empty"><span>{app.name}</span></div>}</section><section class="container detail-content"><div class="detail-copy"><article><p class="eyebrow">Tổng quan</p><h2>Công cụ này làm gì?</h2><p class="prose">{app.primary_use||app.description}</p></article>{app.audience&&<article><h2>Phù hợp với ai?</h2><p class="prose">{app.audience}</p></article>}{features.length>0&&<article><h2>Tính năng</h2><ul class="feature-list">{features.map(x=><li>{x}</li>)}</ul></article>}{app.description&&app.description!==app.primary_use&&<article><h2>Mô tả</h2><p class="prose preserve-lines">{app.description}</p></article>}{app.screenshots&&app.screenshots.length>0&&<article><h2>Screenshots</h2><div class="screenshot-grid">{app.screenshots.map((s:any)=><img src={mediaUrl(s.r2_key)} alt={s.alt_text||app.name} loading="lazy"/>)}</div></article>}</div><aside class="detail-meta"><dl><div><dt>Danh mục</dt><dd>{app.category_name||'—'}</dd></div><div><dt>Phiên bản</dt><dd>{app.version||'—'}</dd></div><div><dt>Nền tảng</dt><dd>{app.platform||'Web'}</dd></div><div><dt>Trạng thái</dt><dd>{statusLabel(app.status)}</dd></div><div><dt>Cập nhật</dt><dd>{dateLabel(app.updated_at)}</dd></div><div><dt>Tech stack</dt><dd>{app.tech_stack||'—'}</dd></div></dl>{app.tags&&app.tags.length>0&&<div class="tag-list">{app.tags.map((t:any)=><span>{t.name}</span>)}</div>}</aside></section>{related.length>0&&<section class="container section-block"><div class="section-heading"><div><p class="eyebrow">Khám phá tiếp</p><h2>Có thể bạn cũng cần</h2></div></div><AppGrid apps={related}/></section>}</PublicLayout>
