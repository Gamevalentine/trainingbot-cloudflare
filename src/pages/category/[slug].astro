---
import PublicLayout from '../../layouts/PublicLayout.astro'; import AppGrid from '../../components/AppGrid.astro'; import { getCategory, listPublicApps, trackCategoryView } from '../../lib/db'; const slug=Astro.params.slug!; const category=await getCategory(slug); if(!category)return new Response('Không tìm thấy',{status:404}); const sort=Astro.url.searchParams.get('sort')||'updated'; const apps=await listPublicApps({category:slug,sort}); const track=()=>trackCategoryView(category.id).catch(()=>{}); if(Astro.defer)Astro.defer(track);else await track();
---
<PublicLayout title={`${category.name} · Web Tools Hub`} description={category.description||`Các công cụ thuộc ${category.name}`}><section class="container page-hero"><p class="eyebrow">Danh mục</p><h1>{category.name}</h1><p>{category.description||`${apps.length} công cụ đang công khai.`}</p></section><section class="container result-header"><span>{apps.length} công cụ</span><form><select name="sort" onchange="this.form.submit()"><option value="updated" selected={sort==='updated'}>Mới cập nhật</option><option value="popular" selected={sort==='popular'}>Phổ biến</option><option value="new" selected={sort==='new'}>Mới thêm</option><option value="name" selected={sort==='name'}>Tên A–Z</option></select></form></section><section class="container section-block no-top"><AppGrid apps={apps}/></section></PublicLayout>
