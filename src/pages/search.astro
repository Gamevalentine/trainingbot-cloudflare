---
import PublicLayout from '../layouts/PublicLayout.astro'; import AppGrid from '../components/AppGrid.astro'; import { listCategories, searchApps } from '../lib/db';
const p=Astro.url.searchParams; const q=p.get('q')||''; const filters={category:p.get('category')||undefined,status:p.get('status')||undefined,platform:p.get('platform')||undefined,pricing:p.get('pricing')||undefined,featured:p.get('featured')==='1',sort:p.get('sort')||undefined}; const [apps,categories]=await Promise.all([searchApps(q,filters),listCategories()]);
---
<PublicLayout title={`${q?`“${q}” · `:''}Tìm kiếm · Web Tools Hub`} description="Tìm công cụ theo tên, nhu cầu, mô tả, danh mục, tag và chức năng."><section class="container search-page"><div class="search-heading"><p class="eyebrow">Tìm theo nhu cầu</p><h1>{q?<>Kết quả cho “{q}”</>:`Bạn đang muốn làm gì?`}</h1><form class="hero-search search-page-box" action="/search"><input name="q" value={q} placeholder="Ví dụ: Tôi muốn học ECG"/><button>Tìm</button></form></div><details class="mobile-filter"><summary>Bộ lọc</summary><FilterForm /></details><div class="search-layout"><aside class="filter-panel"><FilterForm /></aside><div class="results"><div class="result-header"><span>{apps.length} công cụ phù hợp</span>{q&&<a href="/search">Xóa tìm kiếm</a>}</div><AppGrid apps={apps} emptyText="Thử mô tả nhu cầu theo cách khác hoặc bỏ bớt bộ lọc."/></div></div></section></PublicLayout>

{/** Astro local component */}
{function FilterForm(){return <form class="filters" action="/search"><input type="hidden" name="q" value={q}/><label>Danh mục<select name="category"><option value="">Tất cả</option>{categories.map(c=><option value={c.slug} selected={filters.category===c.slug}>{c.name}</option>)}</select></label><label>Trạng thái<select name="status"><option value="">Tất cả</option><option value="active" selected={filters.status==='active'}>Đang hoạt động</option><option value="development" selected={filters.status==='development'}>Đang phát triển</option><option value="beta" selected={filters.status==='beta'}>Beta</option></select></label><label>Nền tảng<select name="platform"><option value="">Tất cả</option><option value="web" selected={filters.platform==='web'}>Web</option><option value="mobile" selected={filters.platform==='mobile'}>Mobile</option><option value="desktop" selected={filters.platform==='desktop'}>Desktop</option></select></label><label>Loại<select name="pricing"><option value="">Tất cả</option><option value="free" selected={filters.pricing==='free'}>Miễn phí</option><option value="experimental" selected={filters.pricing==='experimental'}>Thử nghiệm</option></select></label><label>Sắp xếp<select name="sort"><option value="" selected={!filters.sort}>Phù hợp nhất</option><option value="updated" selected={filters.sort==='updated'}>Mới cập nhật</option><option value="new" selected={filters.sort==='new'}>Mới thêm</option><option value="popular" selected={filters.sort==='popular'}>Phổ biến</option></select></label><label class="checkbox-row"><input type="checkbox" name="featured" value="1" checked={filters.featured}/> Được đề xuất</label><button class="button primary" type="submit">Áp dụng</button></form>}
