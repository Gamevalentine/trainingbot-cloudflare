---
import PublicLayout from '../layouts/PublicLayout.astro';
import AppGrid from '../components/AppGrid.astro';
import SearchFilters from '../components/SearchFilters.astro';
import { listCategories, smartSearchApps, trackSearch } from '../lib/db';

const params = Astro.url.searchParams;
const q = params.get('q') || '';
const filters = {
  category: params.get('category') || undefined,
  status: params.get('status') || undefined,
  platform: params.get('platform') || undefined,
  pricing: params.get('pricing') || undefined,
  featured: params.get('featured') === '1',
  sort: params.get('sort') || undefined,
};

const [search, categories] = await Promise.all([
  smartSearchApps(q, filters),
  listCategories(),
]);
const { apps, suggestions, intents } = search;
if(q.trim()&&!params.has('probe')){const job=()=>trackSearch(q,apps.length).catch(()=>{});if(Astro.defer)Astro.defer(job);else await job();}
---

<PublicLayout
  title={`${q ? `“${q}” · ` : ''}Tìm kiếm · Toolpick`}
  description="Tìm công cụ theo tên, nhu cầu, mô tả, danh mục, tag và chức năng."
  noIndex={Boolean(q || params.toString())}
>
  <section class="container search-page">
    <div class="search-heading">
      <p class="eyebrow">Tìm theo nhu cầu</p>
      <h1>{q ? `Kết quả cho “${q}”` : 'Bạn đang muốn làm gì?'}</h1>
      <form class="hero-search search-page-box" action="/search">
        <input name="q" value={q} placeholder="Ví dụ: Tôi muốn học ECG" />
        <button>Tìm</button>
      </form>
      {q && intents.length > 0 && <div class="smart-search-intent"><span>Đã hiểu nhu cầu</span>{intents.map((intent)=><b>{intent}</b>)}</div>}
    </div>

    <details class="mobile-filter">
      <summary>Bộ lọc</summary>
      <SearchFilters q={q} filters={filters} categories={categories} />
    </details>

    <div class="search-layout">
      <aside class="filter-panel">
        <SearchFilters q={q} filters={filters} categories={categories} />
      </aside>

      <div class="results">
        <div class="result-header">
          <span>{apps.length} công cụ phù hợp</span>
          {q && <a href="/search">Xóa tìm kiếm</a>}
        </div>
        {apps.length > 0 ? <AppGrid apps={apps} /> : suggestions.length > 0 ? <>
          <div class="smart-search-near"><strong>Chưa có kết quả khớp rõ</strong><span>Đây là những công cụ gần nhu cầu nhất.</span></div>
          <AppGrid apps={suggestions} />
        </> : <AppGrid apps={[]} emptyText="Thử mô tả nhu cầu theo cách khác hoặc bỏ bớt bộ lọc." />}
      </div>
    </div>
  </section>
</PublicLayout>
