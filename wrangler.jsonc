{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toolpick",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "web-tools-hub-db",
      "database_id": "7b7b3320-566b-44b9-bda5-f0249f487874",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "web-tools-hub-media"
    }
  ],
  "vars": {
    "SITE_NAME": "Toolpick",
    "SITE_URL": "https://toolpick.ai-vn.workers.dev",
    "REQUIRE_ACCESS": "true"
  }
}
